class Solution {
    public static void incresingNumbers(int n,ArrayList<Integer> list,int num){
        if(n==0){
            list.add(num);
            return;
        }
        int last=num%10;
        for(int i=last+1;i<=9;i++){
            incresingNumbers(n-1,list,num*10+i);
        }
    }
    public static ArrayList<Integer> increasingNumbers(int n) {
        // code here
        ArrayList<Integer> list=new ArrayList<>();
        if(n==1){
            list.add(0);
        }
        incresingNumbers(n,list,0);
        return list;
    }
}
